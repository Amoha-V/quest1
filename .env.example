# ---- core pipeline ----
OUTPUT_DIR=./outputs
DOWNLOAD_DIR=./outputs/_downloads
LOG_LEVEL=INFO

# sampling
COARSE_SAMPLE_INTERVAL_SEC=1.0
ROI_REFINE_WINDOW_SEC=1.0
ROI_REFINE_STEP_SEC=0.1

# optional add-on: catches dialogue shorter than COARSE_SAMPLE_INTERVAL_SEC
# via a cheap (OCR-free) pixel-diff pass over the subtitle band. Off by default.
CHANGE_DETECTION_ENABLED=false
CHANGE_DETECT_INTERVAL_SEC=0.15
CHANGE_DETECT_THRESHOLD=12.0

# OCR / matching thresholds
OCR_MIN_CONFIDENCE=0.4
TEXT_SIMILARITY_THRESHOLD=0.82
DIALOGUE_DEDUP_THRESHOLD=0.85

# Dialogue lives in the lower third — ignore titles/watermarks above it
SUBTITLE_ROI_ENABLED=true
SUBTITLE_ROI_TOP_FRAC=0.70
SUBTITLE_ROI_HEIGHT_FRAC=0.30

# ASR (spoken dialogue) — runs concurrently with the OCR scan; target text
# may be spoken rather than shown as on-screen text. Transcription is
# chunked across ASR_CHUNK_WORKERS processes running in parallel.
ASR_MODEL_SIZE=base.en
ASR_LANGUAGE=en
ASR_VAD_FILTER=true
ASR_CHUNK_WORKERS=2

# ---- service layer (only used if running service/main.py) ----
REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgresql://frame_finder:frame_finder@localhost:5432/frame_finder
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=frame-finder-frames
